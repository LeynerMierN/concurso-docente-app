{
  "app_metadata": {
    "name": "Concurso Docente App",
    "tagline": "Tu pasaporte a la Carrera Magisterial en Colombia",
    "version": "1.0.0",
    "description": "Plataforma de preparación de alto rendimiento para el Concurso de Mérito Docente y Directivos Docentes (CNSC / ICFES / MEN).",
    "target_audience": "Aspirantes a Docentes de Aula y Directivos Docentes en contextos Rurales y No Rurales.",
    "supported_frameworks": [
      "Next.js 14+",
      "Tailwind CSS",
      "React",
      "Lucide React",
      "Shadcn UI",
      "Zustand / LocalStorage"
    ]
  },
  "ui_theme": {
    "color_palette": {
      "primary": {
        "light": "#2563EB",
        "DEFAULT": "#1E40AF",
        "dark": "#1E3A8A",
        "label": "Azul Institucional"
      },
      "secondary": {
        "light": "#10B981",
        "DEFAULT": "#059669",
        "dark": "#047857",
        "label": "Verde Éxito / Acierto"
      },
      "accent": {
        "light": "#F59E0B",
        "DEFAULT": "#D97706",
        "dark": "#B45309",
        "label": "Ámbar Premium / Insignias"
      },
      "danger": {
        "light": "#EF4444",
        "DEFAULT": "#DC2626",
        "dark": "#B91C1C",
        "label": "Rojo Error / Alerta"
      },
      "background": {
        "light": "#F8FAFC",
        "dark": "#0F172A"
      },
      "card_bg": {
        "light": "#FFFFFF",
        "dark": "#1E293B"
      },
      "text": {
        "primary": "#0F172A",
        "secondary": "#475569",
        "muted": "#94A3B8"
      }
    },
    "typography": {
      "font_family_sans": "Inter, system-ui, sans-serif",
      "font_family_heading": "Plus Jakarta Sans, sans-serif"
    },
    "layout_breakpoints": {
      "mobile": "320px",
      "tablet": "768px",
      "desktop": "1024px"
    },
    "dark_mode_supported": true
  },
  "navigation_modules": [
    {
      "id": "home",
      "label": "Inicio / Dashboard",
      "icon": "LayoutDashboard",
      "route": "/",
      "description": "Vista general del progreso, racha diaria y acceso rápido a modalidades."
    },
    {
      "id": "practica",
      "label": "Práctica Guiada",
      "icon": "BookOpenCheck",
      "route": "/practica",
      "description": "Retroalimentación inmediata con explicación y cita de norma tras cada pregunta."
    },
    {
      "id": "simulacros",
      "label": "Simulacros Reales",
      "icon": "Timer",
      "route": "/simulacros",
      "description": "Pruebas con temporizador real estilo ICFES sin feedback hasta finalizar."
    },
    {
      "id": "normatividad",
      "label": "Fichas Normativas",
      "icon": "FileText",
      "route": "/normatividad",
      "description": "Biblioteca interactiva de flashcards con decretos, leyes y guías del MEN."
    },
    {
      "id": "estadisticas",
      "label": "Mi Rendimiento",
      "icon": "BarChart3",
      "route": "/estadisticas",
      "description": "Métricas por área, mapa de fortalezas/debilidades y proyección de puntaje."
    },
    {
      "id": "premium",
      "label": "Modo Premium",
      "icon": "Crown",
      "route": "/premium",
      "description": "Desbloqueo de bancos de especialidad, simulacros ilimitados y descargas PDF."
    }
  ],
