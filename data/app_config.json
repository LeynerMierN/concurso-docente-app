  "exam_modes": [
    {
      "id": "express_10",
      "name": "Entrenamiento Rápido (10 Preguntas)",
      "duration_minutes": 0,
      "question_count": 10,
      "instant_feedback": true,
      "allow_pause": true,
      "description": "Ideal para repasar en 10 minutos con retroalimentación inmediata."
    },
    {
      "id": "area_20",
      "name": "Prueba por Competencia (20 Preguntas)",
      "duration_minutes": 30,
      "question_count": 20,
      "instant_feedback": true,
      "allow_pause": true,
      "description": "Enfocado en una sola área de conocimiento a libre elección."
    },
    {
      "id": "simulacro_medio",
      "name": "Simulacro Parcial (50 Preguntas)",
      "duration_minutes": 120,
      "question_count": 50,
      "instant_feedback": false,
      "allow_pause": false,
      "description": "Prueba cronometrada sin ayuda visual hasta la entrega."
    },
    {
      "id": "simulacro_oficial_100",
      "name": "Simulacro Tipo ICFES / CNSC (100 Preguntas)",
      "duration_minutes": 270,
      "question_count": 100,
      "instant_feedback": false,
      "allow_pause": false,
      "description": "Replicación exacta del examen oficial de 4 horas y 30 minutos."
    }
  ],
